{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maru Scanner",
  "version": "1.0.0",
  "identifier": "com.maru.scanner",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1429",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Maru Scanner",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "maximizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["scan"],
        "name": "Maru Scan Archive",
        "description": "Maru Scanner Document Archive",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "scripts/*"
    ]
  }
}
