{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAudio",
  "version": "1.0.0",
  "identifier": "com.maru.maudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MAudio",
        "width": 1440,
        "height": 900,
        "maximized": false,
        "fullscreen": false,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
