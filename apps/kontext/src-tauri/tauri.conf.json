{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kontext",
  "version": "0.1.0",
  "identifier": "com.maru.kontext",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1428",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kontext",
        "width": 900,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": false
      },
      {
        "label": "overlay",
        "title": "Kontext Overlay",
        "url": "index.html#overlay",
        "width": 560,
        "height": 180,
        "minWidth": 320,
        "minHeight": 120,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
