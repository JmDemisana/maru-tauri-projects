{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maru Characters",
  "version": "0.1.0",
  "identifier": "com.maru.characters",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1432",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Maru Characters",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/models/*.gguf",
      "resources/bin/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
