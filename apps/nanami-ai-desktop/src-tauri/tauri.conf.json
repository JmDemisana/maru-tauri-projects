{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nanami AI",
  "version": "1.0.0",
  "identifier": "io.maru.desktop.nanamiai",
  "build": {
    "devUrl": "https://nanami-ai.pages.dev",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nanami AI",
        "url": "https://nanami-ai.pages.dev",
        "width": 480,
        "height": 760,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
