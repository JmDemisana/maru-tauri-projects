{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monika Piano Maker",
  "version": "1.0.1",
  "identifier": "com.maru.monika-piano",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Monika Piano Maker",
        "width": 1440,
        "height": 900,
        "maximized": true,
        "fullscreen": false,
        "resizable": false,
        "maximizable": false,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
