{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turns Calculator",
  "version": "1.0.0",
  "identifier": "com.maru.turns-calculator",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1426",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Turns Calculator",
        "width": 420,
        "height": 660,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
